# API gateway (same base used by incycle-web REACT_APP_API_URL)
API_BASE_URL=https://api.example.com

# Credentials for POST /auth/login — never commit real values
AUTH_EMAIL=automation@example.com
AUTH_PASSWORD=change-me
AUTH_COUNTRY_CODE=us
AUTH_CONSUMER_USERNAME=centralizer_website

# Merchant that owns the Dropship order-split shop
MERCHANT_CODE=Incycle

# Schedule (node-cron; interpreted in SCHEDULE_TIMEZONE)
SCHEDULE_TIMEZONE=America/Los_Angeles
DEACTIVATE_CRON=0 18 * * *
ACTIVATE_CRON=0 23 * * *

# Runtime
NODE_ENV=development
SCHEDULER_ENABLED=true
LOG_LEVEL=info
