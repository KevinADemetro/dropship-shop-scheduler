{
  "name": "dropship-shop-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Schedules Dropship Fulfillment Priority activation/deactivation via node-cron",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "cli": "ts-node src/cli.ts",
    "run:login": "ts-node src/cli.ts login",
    "run:deactivate": "ts-node src/cli.ts deactivate",
    "run:activate": "ts-node src/cli.ts activate",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.8.3",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
